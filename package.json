{
  "name": "typeorm-pg",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write \"src/**/*.ts\"",
    "ncc-build": "ncc build src/index.ts -t -o build",
    "build": "rm -rf build && mkdir build && npm run ncc-build",
    "dev": "ENV=dev nodemon src/index.ts",
    "start": "ENV=prod nodemon src/index.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:create": "npm run typeorm -- migration:create ./src/db/migrations/static",
    "migration:generate": "npm run typeorm -- migration:generate -d ./dbconfig.ts ./src/db/migrations/generated",
    "migration:run": "npm run typeorm -- -d ./dbconfig.ts migration:run",
    "migration:revert": "npm run typeorm -- -d ./dbconfig.ts migration:revert",
    "migration:show": "npm run typeorm -- -d ./dbconfig.ts migration:show",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^5.1.1",
    "express": "^4.19.2",
    "handlebars": "^4.7.8",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "nodemailer": "^6.9.14",
    "pg": "^8.12.0",
    "typeorm": "^0.3.20",
    "typeorm-naming-strategies": "^4.1.0",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/lodash": "^4.17.6",
    "@types/node": "^20.14.4",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vercel/ncc": "0.38.1",
    "dotenv": "^16.4.5",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "nodemon": "^3.1.3",
    "prettier": "^3.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.5"
  }
}
